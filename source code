def main():

    sys.setrecursionlimit(10000)

    n_m_line = sys.stdin.readline()

    while n_m_line.strip() == '':
        n_m_line = sys.stdin.readline()
    n, m = map(int, n_m_line.strip().split())

    KB = []
    for _ in range(n):
        F_lines = sys.stdin.readline().strip()
        while F_lines == '':
            F_lines = sys.stdin.readline().strip()
        if ':' in F_lines:
            _, F_lines = F_lines.split(':', 1)
        f = F_lines.strip()
        parsed_f = parseFormula(f)
        KB.append(parsed_f)

    que_LINE = sys.stdin.readline().strip()
    while que_LINE == '':
        que_LINE = sys.stdin.readline().strip()
    if 'Query:' in que_LINE:
        _, que_LINE = que_LINE.split(':', 1)
    query = parseFormula(que_LINE.strip())

    # Task 1: Natural Deduction Theorem Prover
    prover = natural_Deduction_Theorem_Prover(KB, query)
    prover.prove()

    # Task 2: Resolution Refutation Theorem Prover
    print("\nSwitching to Resolution Refutation  provers using A*...")
    sentences = [str(f) for f in KB]
    query_str = str(query)
    Resolution_theorem_prover_a_star(n, sentences, query_str)


