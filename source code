            return steps[0], derived_ClauseNum
        
        if frozenset(resolution_input) not in KBClauses:
            KBClauses.append(frozenset(resolution_input))
            steps[0] += 1
            printingClauses(derived_ClauseNum, resolution_input, current_clause, other_clause, clause_Maps)  # Using helper
            clause_Maps[derived_ClauseNum] = resolution_input
            derived_ClauseNum += 1
            heuristic_value = CountofUnresolvedHeuristic(current_clause, other_clause)
            heapq.heappush(pq_heaps, (heuristic_value, steps[0], frozenset(resolution_input)))

    return None, derived_ClauseNum

def initializationPQ(KBClauses, pq_heaps, steps):
    for clause in KBClauses:
        heapq.heappush(pq_heaps, (len(clause), steps[0], clause))

def printingClauses(clause_num, clause, current_clause=None, other_clause=None, clause_Maps=None):
    if current_clause and other_clause and clause_Maps:
        print(f"C{clause_num}: {' | '.join(clause)} (Derived from C{list(clause_Maps.keys())[list(clause_Maps.values()).index(current_clause)]} and C{list(clause_Maps.keys())[list(clause_Maps.values()).index(other_clause)]})")
    else:
        print(f"C{clause_num}: {' | '.join(clause)}")

def printNIL_result(current_clause, other_clause, clause_Maps, steps):
    print(f"NIL (Derived from C{list(clause_Maps.keys())[list(clause_Maps.values()).index(current_clause)]} and C{list(clause_Maps.keys())[list(clause_Maps.values()).index(other_clause)]})")
    print(f"Total steps taken: {steps}")

def Resolution_theorem_prover_a_star(num_sentences, sentences, query):
    clause_Nums = 1
    KBClauses = []
    clause_Maps = {}

    # Adding CNF clauses from sentences
    for sentence in sentences:
        CNFS_clauses = conversion_to_CNFs(sentence)
        clause_Nums = addClauses(CNFS_clauses, clause_Nums, clause_Maps, KBClauses)

    # Negating the query and adding its CNF clauses
    query_Negated = '!' + query
    query_Clauses = conversion_to_CNFs(query_Negated)
    clause_Nums = addClauses(query_Clauses, clause_Nums, clause_Maps, KBClauses)

    # Priority queue (heap) initialization
    pq_heaps = []
    steps = [0]  # Steps as a reference to update
    resol_PAIR = set()
    derived_ClauseNum = clause_Nums

    # Initialize the priority queue
    initializationPQ(KBClauses, pq_heaps, steps)

    # Main A* resolution loop
    while pq_heaps:
        _, g, current_clause = heapq.heappop(pq_heaps)

        if not current_clause:
            print(f"NIL found after {steps[0]} steps")
            return steps[0]

        for other_clause in KBClauses:
            if (current_clause, other_clause) in resol_PAIR:
                continue
            resol_PAIR.add((current_clause, other_clause))

            result, derived_ClauseNum = resolveClauses(current_clause, other_clause, clause_Maps, KBClauses, pq_heaps, steps, derived_ClauseNum)
            if result is not None:
                return result

    print("The query cannot be proven using contradiction.")
import time

def performanceAnalysis(inputs):

    results = []
    for input_data in inputs:
        n, m, kb_lines, query_line = input_data
        kb = [parseFormula(line.split(':', 1)[1].strip()) for line in kb_lines]
        query = parseFormula(query_line.split(':', 1)[1].strip())

        # Natural Deduction Theorem Prover
        prover = natural_Deduction_Theorem_Prover(kb, query)

        start_time = time.time()
        prover.prove()
        end_time = time.time()

        compute_time_nd = end_time - start_time
        nodes_explored_nd = prover.nodesExplored

        # Resolution Refutation Theorem Prover
        sentences = [str(f) for f in kb]
        query_str = str(query)

        start_time = time.time()
        steps_taken = Resolution_theorem_prover_a_star(n, sentences, query_str)
        end_time = time.time()

        compute_time_rr = end_time - start_time

        results.append((n, m, nodes_explored_nd, compute_time_nd, steps_taken, compute_time_rr))

    return results

