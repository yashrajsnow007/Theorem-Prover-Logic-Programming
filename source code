# GLobal Register initialized empty for managing propositions below in Deduction and CNF 
Register_p = {}

# Abstract Syntax Tree (AST) Nodes Definitions for PL.
class Prop_Exp:
    def __init__(self, exprsn):
        self.exprsn = exprsn

    def __repr__(self):
        return self.exprsn

    def __eq__(self, other):
        if not isinstance(other, Prop_Exp):
            return False
        return self.exprsn == other.exprsn

    def __hash__(self):
        return hash(self.exprsn)

# Function to fetch Propositions from Register_p
def fetch_Prop(exprsn):
    temp_exp = Register_p.get(exprsn)
    if temp_exp is None:
        temp_exp = Prop_Exp(exprsn)
        Register_p[exprsn] = temp_exp
    return temp_exp

# Binary Operation Class for PL AST Nodes 
class binaryOperation: 
    def __init__(self, operator, left, right):
        self.operator = operator
        self.left = left
        self.right = right

    def __repr__(self):
        return f"({self.left} {self.operator} {self.right})"

    def __eq__(self, other):
        return self.equals(other)

    def equals(self, other):
        if not isinstance(other, binaryOperation):
            return False
        if self.operator != other.operator:
            return False
        if self.left != other.left:
            return False
        if self.right != other.right:
            return False
        return True

    def __hash__(self):
        return hash((self.operator, self.left, self.right))

# Unary Operation Class for PL AST Nodes    
class unaryOperation:
    def __init__(self, operator, operand):
        self.operator = operator
        self.operand = operand

    def __repr__(self):
        return f"({self.operator}{self.operand})"
    
    def __eq__(self, other_exp):
        return self.equals(other_exp)

    def equals(self, other_exp):
        if not isinstance(other_exp, unaryOperation):
            return False
        if self.operator != other_exp.operator:
            return False
        if self.operand != other_exp.operand:
            return False
        return True

    def __hash__(self):
        return hash((self.operator, self.operand))

# Parser for PL 
def parseFormula(f):
    tokenPattern = r'[A-Z]+|[!&|>=()]'
    matches = re.findall(tokenPattern, f)
    tokens = [token for token in matches]
    return parseExpression(tokens)

# Token Handling for PL AST 
def handle_token(token, operator_hierarchy, op_stack, stack):
    match token:
        case _ if re.match(r'[A-Z]+', token):  
            prop = fetch_Prop(token)
            stack.append(prop)

        case '(':  
            op_stack.append(token)

        case ')':  
            while op_stack and op_stack[-1] != '(':
                operator_handler(op_stack, stack)
            if op_stack and op_stack[-1] == '(':
                op_stack.pop()  

        case _ if token in operator_hierarchy: 
            while (op_stack and op_stack[-1] != '(' and
                    operator_hierarchy.get(op_stack[-1], 0) >= operator_hierarchy[token]):
                operator_handler(op_stack, stack)
            op_stack.append(token)

def operator_handler(op_stack, stack):
    op = op_stack.pop()
    if op == '!':
        t = stack.pop()
        stack.append(unaryOperation('!', t))
    else:
        t2 = stack.pop()
        t1 = stack.pop()
        stack.append(binaryOperation(op, t1, t2))

def parseExpression(tokens):
    stack = []  # Stack for AST
    op_stack = []  # Operator Stack for PL

    operator_hierarchy = {'!': 4, '&': 3, '|': 2, '>': 1, '=': 1}

    for t in tokens:
        handle_token(t, operator_hierarchy, op_stack, stack)

    # Apply remaining operators in the stack
    while op_stack:
        operator_handler(op_stack, stack)

    # Finally, return the root of the stack
    return stack[0]

# Theorem Prover using Natural Deduction
class natural_Deduction_Theorem_Prover:
    def __init__(self, kb, query):
        self.originalKB = kb  
        self.query = query  
        self.steps = []  
        self.stepCounter = 0  
        self.stepCounter = 1 
        self.proved_Flag = False  
        self.nodesExplored = 0

    def prove(self):

        # Start with biconditional elimination
        kb = self.biconditional_elimination(self.originalKB)

        # Print initial KB
        self.print_initial_kb()
    
        initial_state = ProofState(kb=kb, inferred=set(), steps=[], hypothesisAssum=[])
        queue = deque()

        # Adding initial state to the queue
        for state in [initial_state]:
            queue.append(state)
            
        visited_states = set()

        while queue:
            curr_State = queue.popleft()
            self.nodesExplored += 1
            # Check if query is already inferred
            if self.formula_in_set(self.query, curr_State.inferred):
                self.proved_Flag = True
                self.steps = curr_State.steps
                break

            # Avoid revisiting the same state
            if curr_State in visited_states:
                continue
            visited_states.add(curr_State)

            # Apply inference rules
            newStates = self.apply_Logical_inferequilences(curr_State)
            queue.extend(newStates)

        # Print the steps
        self.print_steps()

    def print_initial_kb(self):
        for temp_formula in self.originalKB:
            print(f"S{self.stepCounter}: {temp_formula}")
            self.stepCounter += 1

    def print_steps(self):
        if self.proved_Flag:
            for s_i in self.steps:
                print(f"S{self.stepCounter}: {s_i}")
                self.stepCounter += 1
            print(f"Total steps taken: {self.stepCounter - 1}")
        else:
            print(f"Query {self.query} could not be derived.")
            print(f"Total steps taken: {self.stepCounter - 1}")


    def eliminate_iff(self,f):
        firstImply = binaryOperation('>', f.left, f.right)
        secondImply = binaryOperation('>', f.right, f.left)
        return firstImply, secondImply

    def biconditional_elimination(self, kb):
        updated_KB = []

        for f1 in kb:
            if not (isinstance(f1, binaryOperation) and f1.operator == '='):
                updated_KB.append(f1)
                continue
            
        for f2 in kb:
            if isinstance(f2, binaryOperation) and f2.operator == '=':
                firstImply, secondImply = self.eliminate_iff(f2)
                updated_KB.append(firstImply)
                updated_KB.append(secondImply)
                self.steps.append(f"Inferred {firstImply} and {secondImply} via Biconditional Elimination from {f2}.")
       
        return updated_KB

    def formula_in_set(self, formula, formula_set):
        for f in formula_set:
            if f == formula:
                return True
        return False
    
    def formula_in_set_new(self, formula, formula_set):
        return any(f == formula for f in formula_set)
    
    def extract_propositions(self, formula):
        
        if isinstance(formula, Prop_Exp):
            return [formula]
        elif isinstance(formula, unaryOperation):
            return self.extract_propositions(formula.operand)
        elif isinstance(formula, binaryOperation):
            return self.extract_propositions(formula.left) + self.extract_propositions(formula.right)
        else:
            return []


    def handle_and_introduction(self, LHS_suff, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):

        if isinstance(LHS_suff, binaryOperation) and LHS_suff.operator == '&':
            left = LHS_suff.left
            right = LHS_suff.right

            if self.formula_in_set(left, all_Formulas) and self.formula_in_set(right, all_Formulas):
                if not self.formula_in_set(LHS_suff, all_Formulas):

                    freshlyInferr = inferred.copy()
                    freshlyInferr.add(LHS_suff)
                    newSteps = steps + [f"Inferred {LHS_suff} via And-Introduction from {left} and {right}."]
                    newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                    newStates.append(newState)
                    return True
        return False
    
    
    def handle_or_introduction(self, LHS_suff, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
        
        if isinstance(LHS_suff, binaryOperation) and LHS_suff.operator == '|':
            left = LHS_suff.left
            right = LHS_suff.right
            if self.formula_in_set(left, all_Formulas) or self.formula_in_set(right, all_Formulas):
                if not self.formula_in_set(LHS_suff, all_Formulas):
                    knownDisjoint = left if self.formula_in_set(left, all_Formulas) else right
                    freshlyInferr = inferred.copy()
                    freshlyInferr.add(LHS_suff)
                    newSteps = steps + [f"Inferred {LHS_suff} via Or-Introduction from {knownDisjoint}."]
                    newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                    newStates.append(newState)
                    return True
        return False

    def handle_modus_ponens(self, LHS_suff, RHS_ness, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb, imp):

        if self.formula_in_set(LHS_suff, all_Formulas):
            if not self.formula_in_set(RHS_ness, all_Formulas):

                freshlyInferr = inferred.copy()
                freshlyInferr.add(RHS_ness)
                newSteps = steps + [f"Inferred {RHS_ness} via Modus Ponens from {imp} and {LHS_suff}."]
                newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)
                if RHS_ness == self.query:
                    self.proved_Flag = True
                    self.steps = newSteps
                    return True
        return False
    
    def handle_and_elimination(self, conj, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
        left = conj.left
        right = conj.right
        for operand in [left, right]:
            if not self.formula_in_set(operand, all_Formulas):
                freshlyInferr = inferred.copy()
                freshlyInferr.add(operand)
                newSteps = steps + [f"Inferred {operand} via And-Elimination from {conj}."]
                newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)
                if operand == self.query:
                    self.proved_Flag = True
                    self.steps = newSteps
                    return True
        return False

    def apply_Logical_inferequilences(self, state):

        newStates = []
        kb = state.kb
        inferred = state.inferred
        steps = state.steps
        hypothesisAssum = state.hypothesisAssum

        # Combine kb and inferred for comprehensive inference
        all_Formulas = set(kb) | inferred

        # Modus Ponens
        implications = []
        for f in all_Formulas:
            if isinstance(f, binaryOperation) and f.operator == '>':
                implications.append(f)
        
        for imp in implications:
            LHS_suff = imp.left
            RHS_ness = imp.right

            # Handle And-Introduction when LHS_suff is a conjunction
            if self.handle_and_introduction(LHS_suff, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
                continue
 
            # Handle Or-Introduction when LHS_suff is a disjunction
            if self.handle_or_introduction(LHS_suff, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
                continue
                    
            # Apply Modus Ponens if LHS_suff is in all_Formulas
            if self.handle_modus_ponens(LHS_suff, RHS_ness, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb, imp):
                return []

        # And-Elimination
        conjunctions = []
        for f in all_Formulas:
            if isinstance(f, binaryOperation) and f.operator == '&':
                conjunctions.append(f)
        
        for conj in conjunctions:
            if self.handle_and_elimination(conj, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
                return []


        # Or-Elimination (Branching)
        disjunctions = []
        for f in kb:
            if isinstance(f, binaryOperation) and f.operator == '|':
                disjunctions.append(f)
         
        for formula in disjunctions:
            left = formula.left
            right = formula.right

            # Assume the left operand
            new_inferred1 = inferred.copy()
            new_inferred1.add(left)
            newSteps1 = steps + [f"Assume {left} (from {formula})."]
            newState1 = ProofState(kb=kb, inferred=new_inferred1, steps=newSteps1, hypothesisAssum=hypothesisAssum + [left])

            # Assume the right operand
            new_inferred2 = inferred.copy()
            new_inferred2.add(right)
            newSteps2 = steps + [f"Assume {right} (from {formula})."]
            newState2 = ProofState(kb=kb, inferred=new_inferred2, steps=newSteps2, hypothesisAssum=hypothesisAssum + [right])

            # Prove query from both branches
            branch1_success, branch1_steps = self.prove_branch(newState1)
            branch2_success, branch2_steps = self.prove_branch(newState2)

            # Ensure both branches succeed
            if branch1_success and branch2_success:
                newSteps = steps + [f"By Or-Elimination on {formula}, since {self.query} is derived from both {left} and {right}."]
                newSteps += branch1_steps + branch2_steps
                combined_inferred = inferred.union([self.query])
                newState = ProofState(kb=kb, inferred=combined_inferred, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)
                self.proved_Flag = True
                self.steps = newSteps
                return []

        return newStates
        # Or-Elimination (Branching) (not needed here)

        
    def prove_branch(self, state):

        queue = deque()
        for s in [state]:
            queue.append(s)

        visited_states = []

        while queue:
            curr_State = queue.popleft()
            self.nodesExplored += 1
            # Check if the query is already inferred
            if self.formula_in_set(self.query, curr_State.inferred):
                return True, curr_State.steps

            # Avoid revisiting the same state
            if curr_State in visited_states:
                continue
            visited_states.append(curr_State)

            # Apply inference rules
            newStates = self.apply_Logical_inferequilences_branch(curr_State)
            queue.extend(newStates)

        return False, []

    def handle_modus_ponens_branching(self, imp, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
        LHS_suff = imp.left
        RHS_ness = imp.right
        if self.formula_in_set(LHS_suff, all_Formulas):
            if not self.formula_in_set(RHS_ness, all_Formulas):
                freshlyInferr = inferred.copy()
                freshlyInferr.add(RHS_ness)
                newSteps = steps + [f"Inferred {RHS_ness} via Modus Ponens from {imp} and {LHS_suff}."]
                newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)

    def handle_and_elimination_branching(self, conj, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
        left = conj.left
        right = conj.right
        for operand in [left, right]:
            if not self.formula_in_set(operand, all_Formulas):
                freshlyInferr = inferred.copy()
                freshlyInferr.add(operand)
                newSteps = steps + [f"Inferred {operand} via And-Elimination from {conj}."]
                newState = ProofState(kb=kb, inferred=freshlyInferr, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)

    def handle_biconditional_elimination_branching(self, bicond, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb):
        left = bicond.left
        right = bicond.right
        implications = [binaryOperation('>', left, right), binaryOperation('>', right, left)]
        for imp in implications:
            if not self.formula_in_set(imp, all_Formulas):
                updated_KB = list(kb) + [imp]
                newSteps = steps + [f"Inferred {imp} via Biconditional Elimination from {bicond}."]
                newState = ProofState(kb=updated_KB, inferred=inferred, steps=newSteps, hypothesisAssum=hypothesisAssum)
                newStates.append(newState)

    def apply_Logical_inferequilences_branch(self, state):
        newStates = []
        kb = state.kb
        inferred = state.inferred
        steps = state.steps
        hypothesisAssum = state.hypothesisAssum

        # Combine kb and inferred for comprehensive inference
        all_Formulas = set(kb) | inferred

        # Modus Ponens
        implications = []
        for f in all_Formulas:
            if isinstance(f, binaryOperation) and f.operator == '>':
                implications.append(f)
        
        for imp in implications:
            self.handle_modus_ponens_branching(imp, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb)

        # And-Elimination
        conjunctions = []
        for f in all_Formulas:
            if isinstance(f, binaryOperation) and f.operator == '&':
                conjunctions.append(f)

        
        for conj in conjunctions:
            self.handle_and_elimination_branching(conj, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb)

        # Biconditional Elimination
        biconditionals = []
        for f in all_Formulas:
            if isinstance(f, binaryOperation) and f.operator == '=':
                biconditionals.append(f)
        
        for bicond in biconditionals:
            self.handle_biconditional_elimination_branching(bicond, all_Formulas, inferred, steps, hypothesisAssum, newStates, kb)

        return newStates


class ProofState:

    def __init__(self, kb, inferred, steps, hypothesisAssum):
        self.kb = kb  # List of formulas
        self.inferred = inferred  # Set of inferred propositions/formulas
        self.steps = steps  # List of steps taken
        self.hypothesisAssum = hypothesisAssum  # List of hypothesisAssum made (for branching)

    def __eq__(self, other):
        return self.equals(other)

    def __eq__(self, other):
        if not isinstance(other, ProofState):
            return False
        if set(self.kb) != set(other.kb):
            return False
        if self.inferred != other.inferred:
            return False
        if self.hypothesisAssum != other.hypothesisAssum:
            return False
        return True

    def __hash__(self):
        return hash((frozenset(self.kb), frozenset(self.inferred), tuple(self.hypothesisAssum)))


# CNF Conversion Functions

# this will remove > and = from the formulas
def eliminateImplications(ast):
    if isinstance(ast, Prop_Exp):
        return ast
    
    elif isinstance(ast, unaryOperation):
        return unaryOperation(ast.operator, eliminateImplications(ast.operand))
    
    elif isinstance(ast, binaryOperation):
        term_ness = eliminateImplications(ast.left)
        term_suff = eliminateImplications(ast.right)

        if ast.operator == '>':
            return implicationConversion(term_ness, term_suff)
        
        elif ast.operator == '=':
            return EqConverter(term_ness, term_suff)
        
        else:
            return binaryOperation(ast.operator, term_ness, term_suff)

def implicationConversion(term_ness, term_suff):
    return binaryOperation('|', unaryOperation('!', term_ness), term_suff)

def EqConverter(left, right):
    term_ness = implicationConversion(left, right)
    term_suff = implicationConversion(right, left)
    return binaryOperation('&', term_ness, term_suff)

def handle_negation(op):

    # here De-morgans law is applied to the operand depending on case 
    if isinstance(op, Prop_Exp):
        return unaryOperation('!', op)
    
    elif isinstance(op, unaryOperation):
        return move_NegationInwards(op.operand)
    
    elif isinstance(op, binaryOperation):
        if op.operator == '&':
            term_ness = move_NegationInwards(unaryOperation('!', op.left))
            term_suff = move_NegationInwards(unaryOperation('!', op.right))
            return binaryOperation('|', term_ness, term_suff)
        
        elif op.operator == '|':
            term_ness = move_NegationInwards(unaryOperation('!', op.left))
            term_suff = move_NegationInwards(unaryOperation('!', op.right))
            return binaryOperation('&', term_ness, term_suff)

def move_NegationInwards(ast):
    if isinstance(ast, Prop_Exp):
        return ast
    
    elif isinstance(ast, unaryOperation):
        return handle_negation(ast.operand)
    
    elif isinstance(ast, binaryOperation):
        term_ness = move_NegationInwards(ast.left)
        term_suff = move_NegationInwards(ast.right)
        return binaryOperation(ast.operator, term_ness, term_suff)

def handleAND_helper_func(ast):
        term_ness = distribute_OR_over_AND(ast.left)
        term_suff = distribute_OR_over_AND(ast.right)
        return binaryOperation('&', term_ness, term_suff)

def handleOR_helper_func(ast):
        term_ness = distribute_OR_over_AND(ast.left)
        term_suff = distribute_OR_over_AND(ast.right)

        if isinstance(term_ness, binaryOperation) and term_ness.operator == '&':
            new_left = distribute_OR_over_AND(binaryOperation('|', term_ness.left, term_suff))
            new_right = distribute_OR_over_AND(binaryOperation('|', term_ness.right, term_suff))
            return binaryOperation('&', new_left, new_right)
        
        elif isinstance(term_suff, binaryOperation) and term_suff.operator == '&':
            new_left = distribute_OR_over_AND(binaryOperation('|', term_ness, term_suff.left))
            new_right = distribute_OR_over_AND(binaryOperation('|', term_ness, term_suff.right))
            return binaryOperation('&', new_left, new_right)
        
        else:
            return binaryOperation('|', term_ness, term_suff)

def distribute_OR_over_AND(ast):

    handlers = {
        '&': handleAND_helper_func,
        '|': handleOR_helper_func
    }   

    if isinstance(ast, Prop_Exp) or isinstance(ast, unaryOperation):
        return ast
    elif isinstance(ast, binaryOperation):
        handler = handlers.get(ast.operator)
        if handler:
            return handler(ast)
    return ast

def flat_the_AST(ast):
    handlers = {
        Prop_Exp: handle_prop_exp,
        unaryOperation: handle_unary_operation,
        binaryOperation: handle_binary_operation
    }
    handler = handlers.get(type(ast), handle_default)
    return handler(ast)

def handle_default(ast):
    return []

def handle_prop_exp(ast):
    return [set([str(ast)])]

def handle_unary_operation(ast):
    match ast.operand:
        case Prop_Exp():
            return [set(['!' + str(ast.operand)])]
        case _:
            return []

def handle_binary_operation(ast):
    L_Clause = flat_the_AST(ast.left)
    R_Clause = flat_the_AST(ast.right)
    match ast.operator:
        case '&':
            return L_Clause + R_Clause
        case '|':
            list_of_clauses = []
            for l in L_Clause:
                for r in R_Clause:
                    list_of_clauses.append(l.union(r))
            return list_of_clauses
        case _:
            return []

def conversion_to_CNFs(KnowledgeBase):
    AST = parseFormula(KnowledgeBase)
    AST = eliminateImplications(AST)
    AST = move_NegationInwards(AST)
    AST = distribute_OR_over_AND(AST)
    clauses = flat_the_AST(AST)
    return clauses

# Resolution Functions
def negationOperation(Symbol):
    if Symbol.startswith('!'):
        return Symbol[1:]
    else:
        return '!' + Symbol

def is_tautology(expression_clause):
    for e_i in expression_clause:
        if negationOperation(e_i) in expression_clause:
            return True
    return False

def resolution_inferenceRule(clause_A, clasue_B):

    results = []

    for e_i in clause_A:
        for c_i in clasue_B:
            if e_i == negationOperation(c_i):
                resolution_input = (clause_A - {e_i}) | (clasue_B - {c_i})
                if not is_tautology(resolution_input):
                    results.append(resolution_input)
    return results

# 1st Heuristic function  for A* search based on no. complementary literals
def CountOfNegativesHeusristic(A, B):
    c = 0
    for sym in A:
        if negationOperation(sym) in B:
            c += 1
    return -c  # We want more complementary literals to be prioritized (negative)

# Another heuristic function for A* search based on no. unresolved literals. this is admissible.
def CountofUnresolvedHeuristic(A, B):
    c = 0
    for sym in A:
        if negationOperation(sym) not in B:
            c += 1
    for sym in B:
        if negationOperation(sym) not in A:
            c += 1
    return c



